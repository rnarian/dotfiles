theme = vesper

cursor-color = 99ffe4

adjust-cell-height = 5%
adjust-cursor-thickness = 400%
adjust-cursor-height = -10

background-opacity = 0.85
background-blur-radius = 40

selection-background = e6b99d
selection-foreground = ffffff

font-family = Operator Mono Book
font-size = 16
font-feature = -liga
font-feature = -calt

window-padding-x = 5

keybind = global:cmd+opt+shift+t=toggle_quick_terminal

confirm-close-surface = false

#tabs

macos-titlebar-style = tabs
shell-integration = detect
tab-inherit-working-directory = true

# notify when a command running 5s+ finishes while Ghostty is in the background
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify